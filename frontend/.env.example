# ROCKSPIRE SOFY — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.

# ─── Mock API ───────────────────────────────────────────
# Set to "true" to use the in-memory mock service layer (Milestone 1).
# Set to "false" or remove to use the real FastAPI backend.
VITE_USE_MOCK_API=true

# ─── Real Backend ────────────────────────────────────────
# Base URL of your FastAPI backend. Only used when VITE_USE_MOCK_API=false.
# Example: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ─── Supabase (public keys only — safe in frontend) ─────
# You will get these from your Supabase project settings in Milestone 2.
# NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
